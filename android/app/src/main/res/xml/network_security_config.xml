<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to: android/app/src/main/res/xml/network_security_config.xml in the
  PiliPlus fork, and reference it from the <application> tag:

      android:networkSecurityConfig="@xml/network_security_config"

  PiliPlus targets SDK 37, so usesCleartextTraffic defaults to false and the
  player cannot reach the proxy on http://127.0.0.1 without this. That is
  driven by targetSdk, not by the OS version, so it applies on Android 8 and
  on current releases alike.

  Scoped to loopback deliberately - do NOT set a blanket
  android:usesCleartextTraffic="true" on the application.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
